{
  "functions": {
    "api/search-topics.js": {
      "maxDuration": 120
    },
    "api/generate-infographic.js": {
      "maxDuration": 120
    },
    "api/generate-header.js": {
      "maxDuration": 120
    },
    "api/generate-resource-thumbnail.js": {
      "maxDuration": 300
    },
    "api/generate-article-cover-from-infographic.js": {
      "maxDuration": 300
    },
    "api/generate-article-media-from-infographic.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    { "source": "/services", "destination": "/expertise", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/article-social-image/:slug", "destination": "/api/article-social-image?slug=:slug" },
    { "source": "/api/prompt-social-image/:slug", "destination": "/api/prompt-social-image?slug=:slug" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
